---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import CaseView from '../../components/CaseView.astro';
import { casePath } from '../../lib/paths';

const lang = 'uk';
export async function getStaticPaths() {
  const entries = await getCollection('cases', (e) => e.data.lang === 'uk');
  return entries.map((entry) => ({ params: { slug: entry.data.caseSlug }, props: { entry } }));
}
const { entry } = Astro.props;
const c = entry.data;
---
<Base lang={lang} title={c.metaTitle} description={c.metaDescription} alternates={{ uk: casePath('uk', c.caseSlug), en: casePath('en', c.caseSlug) }}>
  <CaseView entry={entry} />
</Base>
